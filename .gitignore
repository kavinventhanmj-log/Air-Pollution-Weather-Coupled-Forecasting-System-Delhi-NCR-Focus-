# runtime/build caches & artifacts that are fully regenerable
__pycache__/
*.pyc
node_modules/
.vite/
.pytest_cache/
.ml-cache/
.coverage
.coverage.*
*.egg-info/
.DS_Store

# local environment files (real secrets never committed)
.env
.env.local

# runtime logs & local dev databases (regenerable local state)
*.log
*.db

    # frontend build output (produced by npm run build)
frontend/dist/
frontend/*.tsbuildinfo

# The 120MB row-export exceeds GitHub's 100MB push limit.
# It is committed (byte-identical) as part1 + part2; see data/processed/SPLIT_NOTE.txt
data/processed/featured_dataset.csv

# local virtualenv & dev-server pid files
.venv/
*.pid

# regenerable ML byproducts (available via ml/training/train_pm25.py + build_training_dataset.py)
models/pm25/training_predictions.csv
data/ml/
# Vercel project link (contains projectId/orgId) + its local token file - never commit
.vercel/
# Secrets in any local env file, but keep the documented template trackable.
.env
.env.*
!.env.example
# Editor/agent scratch working copies of a source file.
*.bak
*.working.bak
*.orig
*.rej
