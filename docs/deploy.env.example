# AeroCast-NCR production environment template (Docker Compose).
# Copy to a private location (e.g. `deploy.env`) on each host and fill in real
# values. Never commit this file or any real secret.

# --- Database (must match docker-compose `db` service) ---
DATABASE_URL=postgresql://aerocast:CHANGE_ME_PASSWORD@db:5432/aerocast_ncr

# --- Backend ---
ENVIRONMENT=production
LOG_LEVEL=INFO
# Comma-separated browser origins allowed to call the API behind the proxy.
CORS_ORIGINS=https://your-domain.example
# Public URL of the deployed frontend (Vercel); `GET /` on the API redirects
# the browser there instead of answering a bare 404.
FRONTEND_URL=https://your-app.vercel.app

# --- Secrets (production boot FAILS CLOSED without these) ---
# A long random string (>= 32 chars). The development placeholder published in
# backend/app/config.py is refused in production.
SECRET_KEY=CHANGE_ME_LONG_RANDOM_SECRET
# The demo account. Unset stays OFF in production. SIH26082's demo deployment
# opts it back in deliberately -- the published address/password is then served
# by GET /api/auth/demo as the login-page hint; a production boot warns loudly
# about that rather than refusing.
ENABLE_DEMO_USER=true
# DEMO_USER_PASSWORD=CHANGE_ME

# Synthetic self-hydration is forced OFF in production regardless of this key
# (`Settings.demo_hydration_enabled`). An empty database reports itself as
# empty instead of manufacturing history.
DEMO_HYDRATE_EMPTY_DB=false

# Cold-start pre-warm, tri-state. Leave UNSET to keep it ON (the production
# default): the first request triggers a bounded wake-and-retry instead of
# letting panels fail. Set to `false` to opt out explicitly. Progress is
# reported at /api/system under `prewarm` either way.
# CONTROL_ROOM_PREWARM=true

# Optional: register a free MAP_KEY at https://firms.modaps.eosdis.nasa.gov/
NASA_FIRMS_MAP_KEY=

# Optional official data keys; leave empty to keep the honest fallback paths.
# DATA_GOV_API_KEY=
# IMD_API_KEY=

# --- Live data refresh scheduler ---
LIVE_REFRESH_ENABLED=true
LIVE_REFRESH_INTERVAL_HOURS=3
